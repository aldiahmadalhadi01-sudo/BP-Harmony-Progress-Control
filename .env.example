# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# METODE 1: GOOGLE APPS SCRIPT WEB APP (TANPA SERVICE ACCOUNT - PALING MUDAH)
# Pasang script di Google Sheets (Extensions > Apps Script) lalu deploy sebagai Web App (Anyone).
# Masukkan Web App URL di sini:
GOOGLE_SHEETS_WEBAPP_URL="https://script.google.com/macros/s/AKfycb.../exec"

# METODE 2: GOOGLE CLOUD SERVICE ACCOUNT (ALTERNATIF DEVELOPER)
# Email of Google Cloud Service Account with Google Sheets API enabled
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project-id.iam.gserviceaccount.com"

# Private key of Google Cloud Service Account (keep newline formatting or \n)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwgg...=\n-----END PRIVATE KEY-----\n"

# Spreadsheet ID from the Google Sheets URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID="your_google_sheets_spreadsheet_id"

